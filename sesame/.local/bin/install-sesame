#!/usr/bin/env bash

set -euo pipefail

version="0.11.0"
repo="aliou/sesame"
tag="@aliou/sesame-cli@${version}"
target="${HOME}/.local/bin/sesame"

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)
    asset="sesame-darwin-arm64"
    checksum="892b76862800ed427dcb4e6b766b301c6005f74ca7979446e69916e3abcefba5"
    ;;
  Linux-arm64 | Linux-aarch64)
    asset="sesame-linux-arm64"
    checksum="1fdb5be3d0bda16bc49323ff907100a78e9fb706438c3b6436a4011d6fde87df"
    ;;
  Linux-x86_64)
    asset="sesame-linux-x64"
    checksum="3f56097c10144b4ddded9ca769a15759fe1eeb9879bb10998f4ef6a1c87b4b3f"
    ;;
  *)
    echo "Unsupported Sesame platform: $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT
url="https://github.com/${repo}/releases/download/${tag}/${asset}"

curl --fail --location --silent --show-error "${url}" --output "${tmpdir}/${asset}"
echo "${checksum}  ${tmpdir}/${asset}" | shasum -a 256 --check --status
mkdir -p "$(dirname "${target}")"
install -m 0755 "${tmpdir}/${asset}" "${target}"
echo "Installed Sesame ${version} at ${target}"
